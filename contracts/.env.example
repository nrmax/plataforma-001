# ============================================
# NRMAX Contracts - Variaveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# ============================================
# SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ============================================
# INFINITYPAY - WEBHOOK
# ============================================
# Chave secreta para validar webhooks da InfinityPay
INFINITPAY_WEBHOOK_SECRET=sua_chave_secreta_aqui

# ============================================
# ASSINAFY - ASSINATURA ELETRONICA
# ============================================
# API Key obtida em https://api.assinafy.com.br
# Acesse > Login > Developer Dashboard > Create API Key
ASSINAFY_API_KEY=sua_api_key_aqui
# Account ID (workspace) - aparece no dashboard
ASSINAFY_ACCOUNT_ID=seu_account_id_aqui
# Webhook secret para validar notificacoes (opcional)
ASSINAFY_WEBHOOK_SECRET=

# ============================================
# GOOGLE DRIVE - ARMAZENAMENTO (OPCIONAL)
# ============================================
# Caminho para o arquivo de credenciais JSON do Google Cloud
# Se nao configurado, os arquivos ficam apenas locais
GOOGLE_DRIVE_CREDENTIALS_PATH=./credentials.json
# ID da pasta no Google Drive para salvar contratos
GOOGLE_DRIVE_FOLDER_ID=

# ============================================
# EMAIL - SMTP
# ============================================
# Configuracoes do servidor SMTP
# Para Gmail: gere uma "Senha de App" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_aqui
EMAIL_FROM=contratos@nrmax.com.br

# ============================================
# CONTRATO - CONFIGURACOES
# ============================================
# Numero inicial para sequencia de contratos
CONTRACT_SEQUENCE_START=1000
# Prefixo do numero do contrato
CONTRACT_PREFIX=NRMAX
# Prazo de entrega padrao (em dias)
DEFAULT_DELIVERY_DAYS=30
